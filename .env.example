# CareerSetu AI Environment Configuration Template
# DO NOT put real production credentials in this example file.

# SQL Database URL (PostgreSQL / Supabase)
DATABASE_URL=

# SMTP Email Dispatch Service (e.g. Amazon SES, SendGrid, Mailgun, Postmark, Custom SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@careersetu.ai

# Session and Token Encryption Key (Min 32 characters)
SESSION_SECRET=

# Public App URL
VITE_APP_URL=http://localhost:8080
